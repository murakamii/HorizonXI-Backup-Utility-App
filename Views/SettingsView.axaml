<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HorizonXIBackupApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HorizonXIBackupApp.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="16">

            <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="1" Text="HorizonXI install root" FontWeight="SemiBold"/>
            <TextBox Grid.Row="2" Text="{Binding InstallRoot}" Watermark="C:\HorizonXI\Game" Margin="0,4,0,12"/>

            <TextBlock Grid.Row="3" Text="Backup destination" FontWeight="SemiBold"/>
            <TextBox Grid.Row="4" Text="{Binding BackupDestination}" Margin="0,4,0,12"/>

            <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="Retention (snapshots to keep, 0 = all):" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" Value="{Binding Retention}" Minimum="0" Maximum="365" Margin="12,0,0,0" Width="110"/>
            </Grid>

            <CheckBox Grid.Row="6" Content="Include each /addon load folder in backups" IsChecked="{Binding IncludeLoadedAddons}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="7" Text="Ignore addons (comma-separated; skipped by backup and updates)" FontWeight="SemiBold"/>
            <TextBox Grid.Row="8" Text="{Binding IgnoreAddonsText}" Watermark="dynamic_entity_renamer" Margin="0,4,0,12"/>

            <Expander Grid.Row="9" Header="Custom addon URLs" IsExpanded="True" Margin="0,0,0,12">
                <StackPanel Spacing="6">
                    <TextBlock Text="For addons that aren't on horizonxi.info but you want tracked." Foreground="Gray"/>
                    <ItemsControl ItemsSource="{Binding CustomUrls}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="180,*,Auto" Margin="0,2,0,2">
                                    <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="addon name"/>
                                    <TextBox Grid.Column="1" Text="{Binding Url}" Watermark="https://github.com/owner/repo" Margin="6,0,6,0"/>
                                    <Button Grid.Column="2" Content="Remove"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveCustomUrlCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="180,*,Auto" Margin="0,8,0,0">
                        <TextBox Grid.Column="0" Text="{Binding NewCustomUrlName}" Watermark="new addon name"/>
                        <TextBox Grid.Column="1" Text="{Binding NewCustomUrlUrl}" Watermark="https://github.com/owner/repo" Margin="6,0,6,0"/>
                        <Button Grid.Column="2" Content="Add" Command="{Binding AddCustomUrlCommand}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Grid.Row="10" Header="Advanced" IsExpanded="False" Margin="0,0,0,12">
                <StackPanel Spacing="6">
                    <TextBlock Text="GitHub personal access token (optional, raises rate limit from 60/h to 5000/h):" Foreground="Gray"/>
                    <TextBox Text="{Binding GithubToken}" Watermark="ghp_..." PasswordChar="*"/>
                    <CheckBox Content="Show Windows toast when updates are found" IsChecked="{Binding NotifyOnUpdate}" Margin="0,8,0,0"/>
                </StackPanel>
            </Expander>

            <StackPanel Grid.Row="11" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Content="Save" Command="{Binding SaveCommand}" Padding="20,6"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
