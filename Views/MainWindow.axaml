<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HorizonXIBackupApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="HorizonXIBackupApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="600"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <TabControl Margin="6">
        <TabItem Header="Dashboard">
            <ContentControl Content="{Binding Dashboard}"/>
        </TabItem>
        <TabItem Header="Addons">
            <ContentControl Content="{Binding Addons}"/>
        </TabItem>
        <TabItem Header="Backups">
            <ContentControl Content="{Binding Backups}"/>
        </TabItem>
        <TabItem Header="Settings">
            <ContentControl Content="{Binding Settings}"/>
        </TabItem>
    </TabControl>
</Window>
