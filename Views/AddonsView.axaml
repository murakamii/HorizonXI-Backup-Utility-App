<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HorizonXIBackupApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="HorizonXIBackupApp.Views.AddonsView"
             x:DataType="vm:AddonsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <TextBlock Grid.Row="0" Text="Addons loaded from default.txt" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="80"/>
                <DataGridTextColumn Header="Ignored" Binding="{Binding Ignored}" Width="70"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                <DataGridTextColumn Header="SHA" Binding="{Binding Sha}" Width="80"/>
                <DataGridTextColumn Header="Url" Binding="{Binding Url}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
